[Unit]
Description=Dori AI 24/7 server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dori
Group=dori
WorkingDirectory=/opt/dori-ai
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/dori-ai/.venv/bin/python /opt/dori-ai/dori_server.py
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
